# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing (test suites/configs live in the remote repo; keep local copies out of git)
/coverage
/.nyc_output
/test-results
/playwright-report
/blob-report
/cypress/screenshots
/cypress/videos
/cypress/downloads

# test files and directories
**/*.test.js
**/*.test.jsx
**/*.test.ts
**/*.test.tsx
**/*.spec.js
**/*.spec.jsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__/
**/__mocks__/
**/__snapshots__/
**/tests/
**/test/
jest.config.*
jest.setup.*
vitest.config.*
vitest.setup.*
playwright.config.*
cypress.config.*
.nycrc
.nycrc.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local verification / scratch scripts
.color-check.*
.color-fix.*
.verify*.mjs
.verify*.json
.theme-*.mjs
.theme-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
